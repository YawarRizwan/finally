# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data. If empty or
# unset, the built-in market simulator is used.
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (used by E2E
# tests and offline development).
LLM_MOCK=false

# Optional: Portfolio snapshot recording interval in seconds.
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=60
